[Unit]
Description=Games API (FastAPI)
After=network.target postgresql.service

[Service]
# Utilisateur système dédié (sans shell, sans sudo, sans home) : une faille dans l'API ne
# donne accès ni au compte de déploiement ni aux autres sites. Le code appartient à
# matthieu, le groupe `app-games` le lit ; seul logs/ (journal des parties) est en écriture.
User=app-games
Group=app-games
WorkingDirectory=/var/www/games/backend
# Derrière nginx : sans cette variable, uvicorn voit 127.0.0.1 pour tout le monde et le
# rate limiting (entrée par pseudo, création de table) devient un quota global.
Environment=FORWARDED_ALLOW_IPS=127.0.0.1
# Les bots calculent en numpy : un seul thread BLAS par réflexion, sinon numpy en ouvre
# autant que de cœurs et le serveur s'écroule dès que deux bots réfléchissent.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
# Le binaire du venv directement, pas `uv run` : uv voudrait écrire dans un cache, ce que
# le durcissement interdit. Le venv est construit par `uv sync` (deploy.sh).
# Un seul worker, obligatoire : les tables vivent en mémoire du processus.
ExecStart=/var/www/games/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8003 --proxy-headers --ws-max-size 1048576
Restart=always
RestartSec=5
# Les réflexions du bot Difficile passent après les autres sites du serveur.
Nice=5

# Durcissement (systemd-analyze security) : système en lecture seule sauf logs/, pas de
# /home, pas de périphériques, aucune capacité, appels système d'un service.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/games/backend/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Fichiers créés en 664/775 (groupe du site) : matthieu, membre du groupe, peut les
# supprimer ou reconstruire au déploiement suivant.
UMask=0002

[Install]
WantedBy=multi-user.target
